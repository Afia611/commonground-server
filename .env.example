# ---- CommonGround server configuration ----
# Copy this file to `.env` (local dev) and fill in real values.
# Never commit `.env` or `.env.local`.

# Port the Express server listens on
PORT=5000

# MongoDB connection string (MongoDB Atlas or local instance)
# Safe placeholder — replace with your real connection string.
MONGODB_URI=mongodb://127.0.0.1:27017

# Database name
DB_NAME=commonground

# Frontend origins allowed by CORS (comma-separated for multiple).
# Local dev: http://localhost:3000 — add the production URL when deploying.
CLIENT_URL=https://commonground-client-tau.vercel.app,http://localhost:3000

# Secret used to sign JWTs for protected APIs (to be implemented later)
# Use a long random string in real environments, e.g. `openssl rand -hex 64`.
JWT_SECRET=replace_with_development_only_secret

# Origin of the BetterAuth frontend whose /api/auth/jwks endpoint provides
# the public JWKS used to verify Bearer JWTs on protected APIs.
BETTER_AUTH_URL=http://localhost:3000
